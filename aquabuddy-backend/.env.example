# Database
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/aquabuddy?schema=public"

# Server
PORT=3001
NODE_ENV=development

# JWT Secrets
JWT_SECRET="aquabuddy-super-secret-key-change-in-production"
JWT_REFRESH_SECRET="aquabuddy-refresh-secret-key-change-in-production"
JWT_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"

# CORS configuration
FRONTEND_URL="http://localhost:3000"
ALLOWED_ORIGINS="http://localhost:3000,http://localhost:3001,http://localhost:3002"

# Security: Cookie configuration
COOKIE_SECRET="aquabuddy-cookie-secret-key-change-in-production"
COOKIE_DOMAIN="localhost"
COOKIE_SECURE=false # Set to true in production with HTTPS

# Security: CSRF
CSRF_SECRET="aquabuddy-csrf-secret-key-change-in-production"

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# File Upload
MAX_FILE_SIZE=5242880
UPLOAD_DIR="uploads"

# IoT Device Security
IOT_API_KEY="aquabuddy-device-pre-shared-api-key-2024"

# Bruteforce protection
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCKOUT_DURATION_MS=900000
